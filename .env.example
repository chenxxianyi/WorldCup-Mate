# WorldCup Mate 环境变量示例（不要提交真实值）
# 复制为 .env 后填入真实值：cp .env.example .env

# MySQL 数据库
MYSQL_ROOT_PASSWORD=replace_with_strong_password
MYSQL_DATABASE=worldcup_mate

# JWT 签名密钥（生产环境至少 32 位随机字符）
JWT_SECRET=replace_with_at_least_32_random_characters

# 允许的跨域前端地址（多值逗号分隔）
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# football-data.org API Key
FOOTBALL_DATA_API_KEY=

# SMTP 邮件服务（提醒通知）
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# 联赛同步（可选）：格式为 CODE:SEASON,逗号分隔
# SYNC_COMPETITIONS=PL:2025,PD:2025,BL1:2025,SA:2025,FL1:2025
SYNC_COMPETITIONS=
LEAGUE_SYNC_INTERVAL_MINUTES=30
