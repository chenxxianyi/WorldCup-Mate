APP_ENV=development
APP_PORT=8080
JWT_SECRET=please_change_me_to_a_long_random_string
MYSQL_DSN=xxladmin:XXLadmin_2021!@tcp(127.0.0.1:3310)/worldcup_mate?charset=utf8mb4&parseTime=True&loc=Local
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
DATA_SYNC_ENABLED=false
DATA_SYNC_PROVIDER=football-data
DATA_SYNC_LIVE_INTERVAL_SECONDS=120
DATA_SYNC_IDLE_INTERVAL_MINUTES=30
DATA_SYNC_FULL_INTERVAL_HOURS=6
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# League sync (top-5 leagues). Format: CODE:SEASON,COMMA_SEPARATED.
# Empty = World Cup only (default, legacy behavior).
# Example: SYNC_COMPETITIONS=PL:2025,PD:2025,BL1:2025,SA:2025,FL1:2025
SYNC_COMPETITIONS=
LEAGUE_SYNC_INTERVAL_MINUTES=30

# SMTP Email (for reminder notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-password
SMTP_FROM=your-email@example.com
