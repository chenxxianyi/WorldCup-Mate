func localizeAPIPlayerName(sourcePlayerID, englishName string) string {
	return LocalizePlayerName(syncProviderAPIFootball, sourcePlayerID, englishName)
}

func LocalizePlayerName(source, sourcePlayerID, englishName string) string {
	source = strings.TrimSpace(source)
	if source == syncProviderAPIFootball {
		if name := apiFootballPlayerNameZhByID[strings.TrimSpace(sourcePlayerID)]; name != "" {
			return name
		}
	}
	lookupKey := playerNameLookupKey(englishName)
	if name := apiFootballPlayerNameZhByName[lookupKey]; name != "" {
		return name
	}
	if name := playerNamePartZh[lookupKey]; name != "" {
		return name
	}
	return transliteratePlayerName(englishName)
}

func transliteratePlayerName(name string) string {
	name = strings.TrimSpace(name)
	if name == "" {
		return name
	}
	normalized := normalizeLatinName(name)
	parts := strings.FieldsFunc(normalized, func(r rune) bool {
		return r == ' ' || r == '.' || r == '-' || r == '_' || r == '/' || r == '\\'
	})
	localized := make([]string, 0, len(parts))
	for _, part := range parts {
		part = strings.Trim(part, "'`")
		if part == "" {
			continue
		}
		localized = append(localized, transliterateNamePart(part))
	}
	if len(localized) == 0 {
		return name
	}
	return strings.Join(localized, "·")
}

func transliterateNamePart(part string) string {
	part = playerNameLookupKey(part)
	if part == "" {
		return ""
	}
	if name := playerNamePartZh[part]; name != "" {
		return name
	}
	if len([]rune(part)) == 1 {
		for _, r := range part {
			if name := latinInitialZh[r]; name != "" {
				return name
			}
		}
	}

	var out strings.Builder
	for i := 0; i < len(part); {
		matched := false
		for _, chunk := range latinChunkOrder {
			if strings.HasPrefix(part[i:], chunk) {
				out.WriteString(latinChunkZh[chunk])
				i += len(chunk)
				matched = true
				break
			}
		}
		if matched {
			continue
		}
		r := rune(part[i])
		if name := latinInitialZh[r]; name != "" {
			out.WriteString(name)
		}
		i++
	}
	return out.String()
}

func playerNameLookupKey(value string) string {
	value = normalizeLatinName(value)
	value = strings.ToLower(strings.TrimSpace(value))
	return strings.Join(strings.Fields(value), " ")
}

func normalizeLatinName(value string) string {
	value = strings.TrimSpace(value)
	replacer := strings.NewReplacer(
		"À", "A", "Á", "A", "Â", "A", "Ã", "A", "Ä", "A", "Å", "A", "Ā", "A", "Ă", "A", "Ą", "A",
		"à", "a", "á", "a", "â", "a", "ã", "a", "ä", "a", "å", "a", "ā", "a", "ă", "a", "ą", "a",
		"Ç", "C", "Ć", "C", "Č", "C", "ç", "c", "ć", "c", "č", "c",
		"Ð", "D", "Ď", "D", "ð", "d", "ď", "d",
		"È", "E", "É", "E", "Ê", "E", "Ë", "E", "Ē", "E", "Ė", "E", "Ę", "E", "Ě", "E",
		"è", "e", "é", "e", "ê", "e", "ë", "e", "ē", "e", "ė", "e", "ę", "e", "ě", "e",
		"Ğ", "G", "ğ", "g",
		"Ì", "I", "Í", "I", "Î", "I", "Ï", "I", "Ī", "I", "İ", "I",
		"ì", "i", "í", "i", "î", "i", "ï", "i", "ī", "i", "ı", "i",
		"Ł", "L", "ł", "l",
		"Ñ", "N", "Ń", "N", "Ň", "N", "ñ", "n", "ń", "n", "ň", "n",
		"Ò", "O", "Ó", "O", "Ô", "O", "Õ", "O", "Ö", "O", "Ø", "O", "Ō", "O", "Ő", "O",
		"ò", "o", "ó", "o", "ô", "o", "õ", "o", "ö", "o", "ø", "o", "ō", "o", "ő", "o",
		"Ř", "R", "ř", "r",
		"Ś", "S", "Ş", "S", "Š", "S", "ś", "s", "ş", "s", "š", "s", "ß", "ss",
		"Ț", "T", "Ţ", "T", "Ť", "T", "ț", "t", "ţ", "t", "ť", "t",
		"Ù", "U", "Ú", "U", "Û", "U", "Ü", "U", "Ū", "U", "Ů", "U",
		"ù", "u", "ú", "u", "û", "u", "ü", "u", "ū", "u", "ů", "u",
		"Ý", "Y", "Ÿ", "Y", "ý", "y", "ÿ", "y",
		"Ž", "Z", "Ź", "Z", "Ż", "Z", "ž", "z", "ź", "z", "ż", "z",
		"Æ", "Ae", "æ", "ae", "Œ", "Oe", "œ", "oe",
		"’", "'", "‘", "'", "ʼ", "'", "`", "'", "´", "'",
	)
	value = replacer.Replace(value)
	var b strings.Builder
	lastSpace := false
	for _, r := range value {
		switch {
		case r == '\'':
			continue
		case unicode.IsLetter(r) || unicode.IsDigit(r) || r == '.' || r == '-' || r == '_' || r == '/' || r == '\\':
			b.WriteRune(r)
			lastSpace = false
		case unicode.IsSpace(r):
			if !lastSpace {
				b.WriteByte(' ')
				lastSpace = true
			}
		default:
			if !lastSpace {
				b.WriteByte(' ')
				lastSpace = true
			}
		}
	}
	return strings.TrimSpace(b.String())
}
